{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "version": 2,
  "installCommand": "npm install",
  "buildCommand": "echo 'Vercel build completed'",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/",       "destination": "/api/[...all].js" },
    { "source": "/:path*", "destination": "/api/[...all].js" }
  ]
}
